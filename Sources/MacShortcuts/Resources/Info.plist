<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Info.plist
  This file tells macOS important things about Mac Shortcuts:
  - LSUIElement=YES means the app has NO Dock icon (it lives only in the menu bar)
  - NSPrincipalClass points macOS to AppDelegate as the starting point of the app
  - NSAccessibilityUsageDescription explains to the user WHY we need Accessibility access
    (required to post mouse/keyboard events like middle-click)
-->
<plist version="1.0">
<dict>
    <!-- The binary filename inside Contents/MacOS/ that macOS should launch -->
    <key>CFBundleExecutable</key>
    <string>MacShortcuts</string>

    <!-- App name shown in menus and dialogs -->
    <key>CFBundleName</key>
    <string>Mac Shortcuts</string>

    <!-- Unique identifier for the app (reverse-DNS style) -->
    <key>CFBundleIdentifier</key>
    <string>com.mac-shortcuts.app</string>

    <!-- App version -->
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>

    <key>CFBundleVersion</key>
    <string>1</string>

    <!-- Hide the app from the Dock — it will only appear in the menu bar -->
    <key>LSUIElement</key>
    <true/>

    <!-- Show the app in the Dock if set to YES — we want NO so keep as false -->
    <key>LSBackgroundOnly</key>
    <false/>

    <!-- Tell macOS which class to use as the app's starting point -->
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>

    <!-- The class that handles application lifecycle events -->
    <key>NSApplicationDelegateClass</key>
    <string>AppDelegate</string>

    <!-- Explanation shown to the user when we request Accessibility permission.
         macOS REQUIRES this key when you request Accessibility access. -->
    <key>NSAccessibilityUsageDescription</key>
    <string>Mac Shortcuts needs Accessibility access to simulate mouse clicks and keyboard shortcuts when you perform trackpad gestures.</string>

    <!-- Minimum macOS version required -->
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>

    <!-- Supported CPU architectures: Apple Silicon + Intel -->
    <key>LSArchitecturePriority</key>
    <array>
        <string>arm64</string>
        <string>x86_64</string>
    </array>
</dict>
</plist>
